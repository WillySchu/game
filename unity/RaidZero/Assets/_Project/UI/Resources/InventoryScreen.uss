/*
 * The inventory screen's look. Everything visual is here, so restyle freely.
 * Sizes that come from item data (grids, cells, items, slot boxes) are set in code from
 * InventoryPanels.Cell (52 units per cell at the 1920x1080 reference resolution).
 *
 * One rule to keep: don't give .inv-grid a border or padding. Items and the drop highlight
 * are placed by cell from the grid's top-left, and a border would shift them off the cells.
 * Draw grid lines on .inv-cell instead.
 */

/* The whole screen. The dimmed backdrop counts as "outside": dropping there drops the item. */
.inv-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.inv-window {
    flex-direction: column;
    padding: 12px;
    background-color: rgb(22, 24, 22);
    border-width: 1px;
    border-color: rgb(70, 74, 66);
    border-radius: 4px;
}

.inv-columns {
    flex-direction: row;
    height: 860px;
}

.inv-column {
    margin: 0 6px;
}

.inv-panel {
    margin-bottom: 12px;
    padding: 8px;
    background-color: rgb(32, 35, 31);
    border-radius: 3px;
}

.inv-panel--nested {
    background-color: rgb(28, 31, 28);
}

.inv-panel__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.inv-panel__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(214, 210, 196);
}

.inv-panel__close {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 16px;
}

/* Named slots (primary, secondary, armor, rig, backpack). */
.inv-slots {
    flex-direction: row;
    flex-wrap: wrap;
}

.inv-slot-holder {
    margin: 0 8px 8px 0;
}

.inv-slot__caption {
    font-size: 11px;
    color: rgb(150, 150, 138);
    margin-bottom: 2px;
}

.inv-slot {
    background-color: rgb(18, 20, 18);
    border-width: 1px;
    border-color: rgb(64, 68, 60);
}

/* An item in a slot box fills the box rather than being drawn to its footprint. */
.inv-item--in-slot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.inv-grids {
    margin-top: 2px;
}

.inv-grid {
    background-color: rgb(18, 20, 18);
}

.inv-cell {
    border-width: 0 1px 1px 0;
    border-color: rgba(255, 255, 255, 0.06);
}

/* Items, drawn by InventoryItemLook. Category classes come from ItemBadges.Category.
 * Keep the border at 1px or change InventoryItemLook.ItemBorder with it: rotated icons are sized inside it. */
.inv-item {
    padding: 2px 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgb(56, 56, 58);
    overflow: hidden;
}

.inv-item--weapon { background-color: rgb(72, 64, 50); }
.inv-item--magazine { background-color: rgb(60, 66, 50); }
.inv-item--ammo { background-color: rgb(76, 68, 40); }
.inv-item--gear { background-color: rgb(44, 56, 66); }
.inv-item--valuable { background-color: rgb(84, 62, 30); }
.inv-item--barter { background-color: rgb(52, 62, 58); }
.inv-item--other { background-color: rgb(56, 56, 58); }

/* Waiting for the server to answer a request that involves it. */
.inv-item--pending {
    opacity: 0.45;
}

/* The item being dragged, left in place while its ghost follows the pointer. */
.inv-item--dragging {
    opacity: 0.3;
}

.inv-item__name {
    font-size: 11px;
    white-space: normal;
    color: rgb(232, 228, 214);
    -unity-text-align: upper-left;
}

/* The plain look, for items without an icon: the category in small capitals over the name. */
.inv-item__kind {
    font-size: 8px;
    letter-spacing: 1px;
    color: rgba(232, 228, 214, 0.45);
    -unity-text-align: upper-left;
    margin-bottom: 1px;
}

/* With an icon: the picture fills the item, and the name shrinks to a label in the corner. */
.inv-item--has-icon {
    padding: 0;
}

.inv-item__icon {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}

.inv-item__icon--rotated {
    rotate: 90deg;
}

.inv-item--has-icon > .inv-item__name {
    position: absolute;
    top: 1px;
    right: 3px;
    max-width: 90%;
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: upper-right;
    color: rgba(240, 236, 220, 0.85);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}

.inv-item--has-icon > .inv-item__count {
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}

/* The tooltip that appears when the pointer rests on an item (InventoryTooltip). */
.inv-tooltip {
    min-width: 180px;
    max-width: 320px;
    padding: 8px 10px;
    background-color: rgba(16, 18, 16, 0.96);
    border-width: 1px;
    border-color: rgb(96, 102, 88);
    border-radius: 3px;
}

.inv-tooltip__title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    white-space: normal;
}

.inv-tooltip__category {
    font-size: 10px;
    color: rgb(150, 154, 140);
    margin-bottom: 4px;
}

.inv-tooltip__lines {
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding-top: 4px;
}

.inv-tooltip__line {
    flex-direction: row;
    justify-content: space-between;
}

.inv-tooltip__label {
    font-size: 11px;
    color: rgb(160, 164, 150);
    margin-right: 12px;
}

.inv-tooltip__value {
    font-size: 11px;
    color: rgb(232, 228, 214);
    -unity-text-align: upper-right;
    flex-shrink: 1;
    white-space: normal;
}

.inv-tooltip__description {
    margin-top: 6px;
    font-size: 11px;
    color: rgb(190, 192, 178);
    white-space: normal;
}

.inv-item__count {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

/* Dragging. */
.inv-ghost {
    opacity: 0.85;
    padding: 2px 3px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
}

.inv-ghost--ok { border-color: rgb(110, 200, 110); }
.inv-ghost--bad { border-color: rgb(220, 90, 80); }
.inv-ghost--drop { opacity: 0.5; }

/* Where the item would land. Neither ok nor bad: it's where it already is. */
.inv-drop-cells {
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}

.inv-drop-cells--ok {
    background-color: rgba(110, 200, 110, 0.25);
    border-color: rgb(110, 200, 110);
}

.inv-drop-cells--bad {
    background-color: rgba(220, 90, 80, 0.25);
    border-color: rgb(220, 90, 80);
}

.inv-target--ok {
    border-width: 2px;
    border-color: rgb(110, 200, 110);
}

.inv-target--bad {
    border-width: 2px;
    border-color: rgb(220, 90, 80);
}

/* Messages and help. */
.inv-status {
    min-height: 20px;
    margin-top: 6px;
    font-size: 14px;
    color: rgb(230, 150, 120);
}

.inv-help {
    font-size: 11px;
    color: rgb(130, 130, 120);
}

.inv-empty {
    font-size: 13px;
    color: rgb(150, 150, 138);
    margin: 8px 0;
}

/* A container opened from inside another (double-click), and the item it was opened from. */
.inv-panel--opened {
    border-width: 1px;
    border-color: rgb(110, 120, 90);
}

.inv-item--opened {
    border-color: rgb(200, 210, 150);
}

/* Shift-dragging part of a stack: the corner says "split". The border still shows green or red. */
.inv-ghost--split {
    opacity: 0.7;
}

/* "How many?" after a shift-drag. The dimmed area around the box cancels when clicked. */
.inv-split {
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
}

.inv-split__box {
    width: 380px;
    padding: 14px;
    background-color: rgb(32, 35, 31);
    border-width: 1px;
    border-color: rgb(90, 96, 84);
    border-radius: 4px;
}

.inv-split__title {
    font-size: 14px;
    color: rgb(214, 210, 196);
    margin-bottom: 8px;
    white-space: normal;
}

.inv-split__buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}

/* Above the columns and below the status line: empty in a raid, the Hideout's rows (HideoutScreen). */
.inv-header {
    margin-bottom: 8px;
}

.inv-footer {
    margin-top: 6px;
}

/* The Hideout: the player bar or the login row on top, Deploy at the bottom. */
.hideout-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
}

.hideout-row--deploy {
    justify-content: flex-end;
}

.hideout-label {
    font-size: 13px;
    color: rgb(190, 192, 178);
    margin-right: 6px;
}

.hideout-name-field {
    width: 220px;
    margin-right: 6px;
}

.hideout-player {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    margin-right: 12px;
}

.hideout-state {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(214, 180, 110);
    white-space: normal;
}

.hideout-quiet {
    flex-grow: 1;
    font-size: 11px;
    color: rgb(150, 154, 140);
    margin-left: 6px;
}

.hideout-button {
    margin-left: 6px;
    padding: 4px 12px;
}

.hideout-deploy {
    min-width: 140px;
    padding: 8px 20px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
    background-color: rgb(70, 92, 62);
    border-color: rgb(120, 150, 104);
}

/* The result of the last raid, shown once when you're back. */
.hideout-result {
    width: 440px;
}

.hideout-result__title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 236, 220);
}

.hideout-result__sentence {
    font-size: 13px;
    color: rgb(200, 202, 188);
    white-space: normal;
    margin: 4px 0 10px 0;
}

.hideout-result__heading {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(150, 154, 140);
    margin-top: 6px;
}

.hideout-result__line {
    font-size: 13px;
    color: rgb(232, 228, 214);
}

/* The raid HUD (RaidHud): the clock at the top, the extraction countdown low in the middle, and the card you see
 * as you leave. It never takes the mouse: every part ignores picking. */
.hud {
    align-items: center;
}

.hud-clock {
    position: absolute;
    top: 14px;
    padding: 2px 12px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(232, 228, 214);
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 3px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.hud-clock--late {
    color: rgb(236, 120, 96);
}

.hud-extraction {
    position: absolute;
    bottom: 22%;
    align-items: center;
}

.hud-extraction__line {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(170, 230, 150);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.hud-extraction__bar {
    width: 260px;
    height: 6px;
    margin-top: 6px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 3px;
    overflow: hidden;
}

.hud-extraction__fill {
    height: 100%;
    width: 0;
    background-color: rgb(140, 210, 120);
}

/* The card as you leave: in front of the Hideout coming back for a few seconds. */
.hud-card {
    position: absolute;
    top: 34%;
    padding: 20px 40px;
    align-items: center;
    background-color: rgba(10, 12, 10, 0.92);
    border-width: 1px;
    border-color: rgb(90, 96, 84);
    border-radius: 4px;
}

.hud-card__title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(240, 236, 220);
}

.hud-card__detail {
    margin-top: 6px;
    font-size: 15px;
    color: rgb(200, 202, 188);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 520px;
}

.hud-card--extracted .hud-card__title { color: rgb(150, 220, 130); }
.hud-card--lost .hud-card__title { color: rgb(226, 108, 88); }
.hud-card--aborted .hud-card__title { color: rgb(220, 190, 110); }
