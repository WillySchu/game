# Copy to .env and fill in. Never commit .env.

# The DNS name pointing at this server. Caddy fetches its HTTPS certificate.
DOMAIN=api.example.com

# Built by CI on every push to main. Pin a sha-xxxxxxx tag instead of latest to control upgrades.
BACKEND_IMAGE=ghcr.io/your-org/raid-zero/backend:latest

# Generate each of these with: openssl rand -base64 32
TOKEN_SIGNING_KEY=
ADMIN_TOKEN=
GAME_SERVER_TOKEN=

# The game server this backend hands raids to. Host and port are what players' clients connect to.
GAME_SERVER_ID=vps-1
GAME_SERVER_HOST=
GAME_SERVER_PORT=7770
