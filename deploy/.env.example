# Copy to .env and fill in. Never commit .env.

# The DNS name pointing at this server. Caddy fetches its HTTPS certificate.
DOMAIN=api.example.com

# Built by CI from main. Pin sha-xxxxxxx tags instead of latest to control upgrades. The game server only gets
# a new image when the Unity project or shared code changes, so its newest tag can be older than the backend's.
BACKEND_IMAGE=ghcr.io/your-org/raid-zero/backend:latest
GAMESERVER_IMAGE=ghcr.io/your-org/raid-zero/gameserver:latest

# Generate each of these with: openssl rand -base64 32
TOKEN_SIGNING_KEY=
ADMIN_TOKEN=
GAME_SERVER_TOKEN=

# The game server this backend hands raids to, which runs alongside it. Host is this machine's public address
# (its IP or a DNS name), and the port is published as UDP; both are what players' clients connect to.
GAME_SERVER_ID=vps-1
GAME_SERVER_HOST=
GAME_SERVER_PORT=7770
