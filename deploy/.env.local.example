# Copy to .env.local and fill in, for compose.local.yaml. Never commit .env.local.

BACKEND_IMAGE=ghcr.io/willyschu/game/backend:latest
GAMESERVER_IMAGE=ghcr.io/willyschu/game/gameserver:latest

# Generate each of these once. In PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# On a Mac or Linux: openssl rand -base64 32
TOKEN_SIGNING_KEY=
ADMIN_TOKEN=
GAME_SERVER_TOKEN=

# What the backend tells players' clients to connect to. This machine's Tailscale IP (tailscale ip -4) when
# others play over Tailscale, which this machine can use too; 127.0.0.1 when everyone plays on this machine.
GAME_SERVER_HOST=
GAME_SERVER_PORT=7770

# The backend's port on this machine. Editors set backend_url to http://<GAME_SERVER_HOST>:<BACKEND_PORT>.
BACKEND_PORT=5080

# How long raids last. Shorter is handy while testing.
RAID_MINUTES=25
